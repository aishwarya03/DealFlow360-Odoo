# Copy to .env and fill in. Never commit .env itself.

# Neon POOLED connection string (host contains "-pooler").
# pgbouncer=true tells Prisma to skip prepared statements, which a
# transaction-mode pooler cannot keep across connections.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Neon UNPOOLED connection string (same host WITHOUT "-pooler").
# Used only by prisma migrate, which needs session-level advisory locks.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Minimum 16 characters. Rotate before deploying anywhere public.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development

# Copy to .env and fill in. Never commit .env itself.

# Pooled Postgres connection used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct (non-pooled) connection — Prisma Migrate requires this
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Long random string. Generate with: openssl rand -base64 32
JWT_SECRET="replace-me"

PORT=3000

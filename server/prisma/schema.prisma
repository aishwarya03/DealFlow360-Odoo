generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Internal staff roles. Fixed by the business process, so an enum rather than
// a lookup table: no join on every auth check and invalid values cannot exist.
enum Role {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
}

// A table, not an enum: an admin adds PLATINUM by inserting a row, not by
// shipping a migration. Tiers are the first half of every discount rule.
model CustomerTier {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  // Ordering only — 1 is the most conservative tier. Lets reports and pickers
  // sort tiers by seniority without hardcoding the code strings.
  rank Int @unique

  // Lower bound of this tier's score band (0-100). A customer lands in the
  // highest tier whose minScore they reach. Bands are data, so adding
  // PLATINUM at 80 is a row, not a code change.
  minScore Int @default(0)

  // The tier-wide ceiling from the brief ("Bronze up to 5 percent, Silver up
  // to 10, Gold up to 15"). Used ONLY for the order-level check in
  // discountEvaluation.service.js — never as a fallback when a line's
  // category rule is missing, because a missing rule must fail loudly rather
  // than silently allow a discount.
  defaultMaxDiscountPercent Decimal @db.Decimal(5, 2)

  // "then Finance if required" (brief §5). A breach routes to a Sales Manager;
  // Finance is added when the order's blended risk score exceeds this. It sits
  // on the tier rather than on each rule because the score is an order-wide
  // figure — no single line's rule can decide it.
  financeEscalationSeverity Decimal @default(5) @db.Decimal(5, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers     Customer[]
  discountRules DiscountRule[]

  @@map("customer_tiers")
}

// One configured ceiling per (tier x category). This is the whole discount
// policy — nothing in application code hardcodes a percentage.
//
// Deliberately just the one number. A discount at or below maxDiscountPercent
// needs no approval; anything above it routes to a Sales Manager. Whether
// Finance is *also* needed is not a per-rule setting — it is decided by the
// blended risk score across the whole order, which is the only thing that can
// see many small breaches adding up (brief §10).
model DiscountRule {
  id Int @id @default(autoincrement())

  customerTierId Int
  customerTier   CustomerTier @relation(fields: [customerTierId], references: [id])

  // The "product type" axis of the rule. Points at the configurable Category
  // tree, so Hardware / Service / Subscription are rows an admin controls.
  // Resolution walks UP the tree from a product's own category, so a rule on
  // "Hardware" also governs products filed under "Hardware / Computers".
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  maxDiscountPercent Decimal @db.Decimal(5, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Exactly one rule per pair, active or not, so resolution is deterministic
  // — there is never a question of which of two rules applies.
  @@unique([customerTierId, categoryId])
  @@map("discount_rules")
}

// Singleton (id is always 1). Every number the tier scoring engine uses,
// held as configuration so weights and targets are tunable by an admin
// rather than compiled into the calculation.
//
// Weights must total 100. Each "target" is the value that earns full marks
// for its metric — spend at or above purchaseValueTarget scores the whole
// purchaseValueWeight, and so on.
model TierScoringConfig {
  id Int @id @default(1)

  purchaseValueWeight Decimal @default(40) @db.Decimal(5, 2)
  orderCountWeight    Decimal @default(25) @db.Decimal(5, 2)
  recencyWeight       Decimal @default(20) @db.Decimal(5, 2)
  relationshipWeight  Decimal @default(15) @db.Decimal(5, 2)

  purchaseValueTarget     Decimal @default(1250000) @db.Decimal(14, 2)
  orderCountTarget        Int     @default(28)
  // Days since the last order at which recency scores zero; it decays
  // linearly from full marks on the day of the order.
  recencyHorizonDays      Int     @default(80)
  relationshipTargetYears Decimal @default(3) @db.Decimal(5, 2)

  updatedAt DateTime @updatedAt

  @@map("tier_scoring_config")
}

// Internal user. Authenticates against /api/internal/* only.
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(SALES_REP)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotationsOwned   Quotation[]    @relation("QuotationOwner")
  approvalStepsDone ApprovalStep[]
  auditEntries      AuditLog[]

  @@map("users")
}

// Portal user. Authenticates against /api/portal/* only, never internal routes.
// passwordHash is nullable: a customer record exists as a sales entity from the
// moment a rep creates it, long before that customer is ever given portal access.
model Customer {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  passwordHash String?

  // Calculated, not assigned — see tierScoring.service.js. Held as a FK so
  // discount rules can join against it, but written by the scoring engine.
  tierId Int
  tier   CustomerTier @relation(fields: [tierId], references: [id])

  tierScore        Decimal   @default(0) @db.Decimal(5, 2)
  tierCalculatedAt DateTime?

  // The four raw metrics the tier score is computed from. Stored on the
  // customer because there is no order history in the system yet; once the
  // quotation/order slice lands these become derived figures refreshed from
  // real orders, and the scoring engine itself does not change.
  totalPurchaseValue Decimal   @default(0) @db.Decimal(14, 2)
  completedOrders    Int       @default(0)
  lastOrderAt        DateTime?
  customerSince      DateTime  @default(now())

  contactName String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotations Quotation[]

  @@index([tierId])
  @@map("customers")
}

// HOW the product is fulfilled — physical good, labor/service, or a bundle of
// other products. Orthogonal to Category below: two products in the same
// category can differ in type, and this is what the inventory layer checks
// before allowing a stock row to be created (services are never stocked).
// COMBO is accepted for parity with the reference product form; bundle
// composition (which products a combo contains) is not built yet.
enum ProductType {
  GOODS
  SERVICE
  COMBO
}

// A real classification tree (self-referencing), not a fixed enum — an admin
// creates categories the same way they create products. This is the unit
// discount ceilings are configured against: the brief's worked example allows
// Hardware 15% but Service only 10% for the same customer, so a category's
// ceiling is what a line's discount is checked against.
//
// A product may attach to a parent category directly (e.g. "Software") or to
// one of its children (e.g. "Hardware" -> "Computers") — both patterns are
// valid, which is what lets "Electronics" hold both sub-categories and
// products at the same time.
model Category {
  id   Int    @id @default(autoincrement())
  name String

  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  // Ceilings live on DiscountRule, not here: a ceiling is only meaningful for
  // a given customer tier (Gold gets 15% on Hardware where Bronze gets 5%),
  // so a single per-category number could never express the real policy.
  discountRules DiscountRule[]

  // Name only has to be unique among siblings — "Accessories" can exist under
  // both "Hardware" and "Software" without colliding.
  @@unique([parentId, name])
  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  sku         String      @unique
  name        String
  description String?
  productType ProductType @default(GOODS)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  unit String @default("unit")

  // Server-relative path (e.g. "/uploads/products/xyz.jpg") or an external
  // URL. Set via PATCH directly, or via POST /:id/image which uploads a file
  // and writes the resulting path here.
  imageUrl String?

  // Whether this product MAY be sold on a recurring plan. The actual one-time vs
  // recurring decision is made per quotation line, since the same product can be
  // sold either way to different customers; the line validator rejects a
  // recurring line when this is false.
  isSubscribable Boolean @default(false)

  // Money is Decimal, never Float: binary floating point cannot represent 0.1
  // exactly, and that error compounds across discounts, tax and proration.
  listPrice Decimal @db.Decimal(12, 2)
  costPrice Decimal @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory      Inventory[]
  quotationLines QuotationLine[] @relation("QuotationLineProduct")

  // Catalog-configured upsell/cross-sell pairings, evaluated against
  // whatever's currently in an order's lines — see ProductRecommendation.
  recommendationsAsSource ProductRecommendation[] @relation("RecommendationSource")
  recommendationsAsTarget ProductRecommendation[] @relation("RecommendationTarget")

  // Lines added by accepting a suggestion that named this product as the
  // trigger — attribution only, see QuotationLine.suggestedFromProduct.
  suggestedInLines QuotationLine[] @relation("SuggestedFromProduct")

  @@index([categoryId])
  @@map("products")
}

// Upsell = a better/bigger version of what's already in the line.
// Cross-sell = a complementary but different product bought alongside.
// One table, not two: the shape is identical either way and `type` is the
// only thing that differs — it lets one query answer "give me everything
// for this product" while the API still groups results into the two
// logical lists the UI shows separately.
enum RecommendationType {
  UPSELL
  CROSS_SELL
}

// Admin-curated catalog config, evaluated against whatever's currently in
// an order's lines (a quotation or the public cart) to produce suggestions.
// Purely advisory: accepting a suggestion just adds a normal line/cart item
// through the ordinary add-line path — nothing here ever adds anything by
// itself. Only ever shown while the order is actually editable (a
// quotation's own DRAFT/UNDER_NEGOTIATION gate already covers this, since
// accepting a suggestion is just that same add-line path).
model ProductRecommendation {
  id Int @id @default(autoincrement())

  sourceProductId Int // the product already in the order line
  source          Product @relation("RecommendationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProductId Int // the product being suggested
  target          Product @relation("RecommendationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  type RecommendationType

  // Admin-highlighted — e.g. "AI analytics + AMC" called out as a featured
  // pairing rather than left to sort next to every other suggestion.
  promoted Boolean @default(false)

  // Don't surface this pairing if the TARGET's live margin has eroded below
  // this — stops the engine recommending something that still pairs well
  // but isn't worth the rep's time anymore. 0 = no threshold.
  minMarginPercent Decimal @default(0) @db.Decimal(5, 2)

  // Deactivate, not delete — consistent with every other admin-configured
  // table in this schema (DiscountRule, CustomerTier, Product, Customer,
  // Warehouse). Nothing downstream references this row the way a
  // QuotationLine references a Product, so a hard delete would technically
  // be safe, but breaking the house convention in exactly one place buys
  // nothing.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // A pair may exist at most once per type — not prevented from being both
  // an UPSELL and a CROSS_SELL row simultaneously (conceivable, if unusual),
  // just never duplicated within the same type.
  @@unique([sourceProductId, targetProductId, type])
  @@index([sourceProductId, type])
  @@map("product_recommendations")
}

// A stocking location. The spec's fulfillment split has to "minimise the number of
// shipments" while respecting cost, so each warehouse carries the two numbers that
// scoring needs: a fixed cost per dispatch, and a tie-breaking priority.
model Warehouse {
  id   Int     @id @default(autoincrement())
  code String  @unique
  name String
  city String?

  // Fixed cost of dispatching one shipment from here, whatever it contains.
  // The split algorithm scores an allocation as (shipments x this) so that two
  // shipments from a cheap depot can legitimately beat one from an expensive one.
  shippingCostPerShipment Decimal @default(0) @db.Decimal(10, 2)

  // Tie-breaker when cost is equal — lower wins. Lets an admin express "prefer
  // Main unless there is a real reason not to" without inventing a fake cost.
  priority Int @default(100)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory   Inventory[]
  movements   StockMovement[]
  allocations QuotationLineAllocation[]

  @@map("warehouses")
}

// Stock of one product in one warehouse.
//
// onHand and reserved are stored; AVAILABLE IS NOT. Available is always
// onHand - reserved, derived at read time. Storing all three would create two
// numbers that must agree forever, and they eventually would not.
model Inventory {
  id          Int @id @default(autoincrement())
  warehouseId Int
  productId   Int

  // Physically present in this warehouse.
  onHandQty Int @default(0)

  // Already promised to confirmed orders but not yet shipped. Still on the shelf,
  // no longer sellable.
  reservedQty Int @default(0)

  // Replenishment rule. reorderPoint is the level at which this location should be
  // restocked; reorderQty is how much to bring in when it is hit.
  reorderPoint Int @default(0)
  reorderQty   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  // One stock row per product per warehouse — the pair is the real identity.
  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("inventory")
}

enum StockMovementType {
  RECEIPT // stock arriving into a warehouse
  ADJUSTMENT // correction: stocktake, damage, shrinkage
  RESERVATION // committed to a confirmed order
  RELEASE // reservation freed, e.g. cancelled order
  SHIPMENT // reserved stock physically dispatched
}

// An append-only ledger of every change to a stock row. Inventory holds the current
// balance; this explains how it got there.
//
// Worth the extra table: the spec's "consolidate remaining backorder" prompt needs
// to know what already shipped versus what is still owed, and an unexplained stock
// number is the thing operations people trust least.
model StockMovement {
  id          Int               @id @default(autoincrement())
  warehouseId Int
  productId   Int
  type        StockMovementType

  // Signed deltas, so replaying the ledger reproduces the balance exactly.
  onHandDelta   Int @default(0)
  reservedDelta Int @default(0)

  reason    String?
  userId    Int?
  createdAt DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId, productId])
  @@map("stock_movements")
}

// ── Quotations ──────────────────────────────────────────────────────────

// The customer's own request from the public site, before any formal
// Quotation exists. A rep reviews it and manually creates a Customer +
// Quotation if it goes anywhere — no automatic conversion, nothing to keep
// in sync. See docs/SOURCE_OF_TRUTH.md §2.11.
enum QuoteRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  DISMISSED
}

model QuoteRequest {
  id        Int                @id @default(autoincrement())
  name      String
  company   String
  email     String
  phone     String?
  message   String?
  items     Json? // [{ productName, quantity }] — free-text catalog snapshot, not an FK
  status    QuoteRequestStatus @default(NEW)
  createdAt DateTime           @default(now())

  quotations Quotation[]

  @@map("quote_requests")
}

// The quotation IS the order — one row carries status through the whole
// lifecycle, no separate SalesOrder created on confirmation.
//
// REJECTED (an approver said no) and WITHDRAWN (the customer said no) are
// both terminal for this row, but not for the deal — either is the only
// status a new child quotation can be requested from (see previousQuotationId
// on Quotation below). RETURNED, by contrast, loops an ApprovalStep's
// quotation back to DRAFT on the SAME row — see ApprovalStepStatus.
enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  UNDER_NEGOTIATION
  CONFIRMED
  REJECTED
  WITHDRAWN
}

// Not on Product — chosen per QuotationLine, since one-time vs recurring is a
// per-sale decision: the same product can be sold either way to different
// customers.
enum RecurringCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

model Quotation {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ownerId    Int // sales rep
  owner      User     @relation("QuotationOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  status QuotationStatus @default(DRAFT)

  // Approval binds to a VERSION of the terms, not to the quote. Any
  // pricing-relevant edit bumps termsVersion; an approval is only valid
  // while approvedTermsVersion === termsVersion — any edit after approval
  // silently invalidates it, no explicit "unapprove" step needed.
  termsVersion         Int  @default(1)
  approvedTermsVersion Int?

  customerReference String? // the customer's own PO / reference number
  notes             String? // free-text terms, printed on the quote

  // Set once, by the workflow code, on the transition into CONFIRMED.
  // Denormalized deliberately: period-based revenue reporting needs a plain
  // indexed column, not a walk through AuditLog for every row.
  confirmedAt DateTime?

  // Which public lead (if any) started this chain. Copied forward to every
  // quotation in a chain at creation time — a one-time copy of an immutable
  // fact, so it never needs to be kept in sync.
  sourceQuoteRequestId Int?
  sourceQuoteRequest   QuoteRequest? @relation(fields: [sourceQuoteRequestId], references: [id], onDelete: SetNull)

  // The rejected/withdrawn quotation this one re-quotes, if any. @unique
  // makes this a strict chain (at most one successor per predecessor), not a
  // branching tree. Set only when a rep opens an existing quotation and
  // requests a new one from inside it — never by the customer. Restricting
  // this to a REJECTED/WITHDRAWN source is enforced by the service layer,
  // not the database.
  previousQuotationId Int?       @unique
  previousQuotation   Quotation? @relation("QuotationSupersession", fields: [previousQuotationId], references: [id], onDelete: SetNull)
  supersededBy        Quotation? @relation("QuotationSupersession")

  // Curated business signal for the stalled-deal dashboard — bumped only on
  // real activity (line edit, approval action, negotiation message), unlike
  // updatedAt below, which is raw DB bookkeeping touched on any write.
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines            QuotationLine[]
  approvalRequests ApprovalRequest[]
  auditLog         AuditLog[]

  @@index([customerId])
  @@index([ownerId])
  @@index([status])
  @@index([status, lastActivityAt])
  @@index([sourceQuoteRequestId])
  @@index([confirmedAt])
  @@map("quotations")
}

model QuotationLine {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation("QuotationLineProduct", fields: [productId], references: [id], onDelete: Restrict)

  quantity Int

  // Snapshotted at add-time and never recomputed live, so an already-approved
  // quotation can't silently drift when Admin later changes a price, a
  // discount rule, or a GST rate. The audit trail must reflect what was
  // actually approved, at the time it was approved.
  unitPrice       Decimal @db.Decimal(12, 2) // Product.listPrice at add-time
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  ceilingAtEntry  Decimal @db.Decimal(5, 2) // resolved DiscountRule.maxDiscountPercent at add-time
  taxRateAtEntry  Decimal @db.Decimal(5, 2) // Product.taxRate at add-time

  // Per-line billing mode — Product.isSubscribable gates whether this is
  // allowed; the actual choice is made here, per sale, since the same
  // product can be sold one-time to one customer and on a plan to another.
  isRecurring    Boolean         @default(false)
  recurringCycle RecurringCycle?

  // Set only when this line was added by accepting an upsell/cross-sell
  // suggestion — both null for a line picked directly, always set together
  // for one that wasn't (enforced in the service layer, not here — same
  // idiom as "recurringCycle required when isRecurring"). suggestedFromProductId
  // is the OTHER product already on the order that triggered the suggestion.
  // Deliberately a live FK to Product, not a snapshot: Product is never
  // hard-deleted (isActive soft-delete only, same as every reference to it
  // elsewhere in this schema), so this is safe, and unlike unitPrice/
  // ceilingAtEntry this is attribution, not a priced fact that must survive
  // catalog changes untouched. onDelete: SetNull — this line stays fully
  // valid on its own even if that attribution link is ever cleared.
  suggestedAs            RecommendationType?
  suggestedFromProductId Int?
  suggestedFromProduct   Product?            @relation("SuggestedFromProduct", fields: [suggestedFromProductId], references: [id], onDelete: SetNull)

  // How this line's quantity is expected to be sourced across warehouses,
  // decided when the line is added (not deferred to a post-confirmation
  // fulfillment step) — see QuotationLineAllocation.
  allocations QuotationLineAllocation[]

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_lines")
}

// One row per warehouse a QuotationLine's quantity is expected to be drawn
// from, chosen at add-time (auto-suggested by a greedy largest-available-
// first split, editable by the rep) rather than computed fresh after
// confirmation. warehouseId is null for a backorder row — the remainder no
// warehouse can currently cover. Rows are replaced wholesale whenever the
// line's quantity changes, never partially patched.
//
// This only records intent while the quotation is still editable: no
// Inventory.reservedQty is touched here. Real reservation happens once, at
// the transition into CONFIRMED, which replays these rows into actual
// StockMovement(RESERVATION) entries — see quotation.service.js's
// reserveStockForQuotation.
model QuotationLineAllocation {
  id              Int           @id @default(autoincrement())
  quotationLineId Int
  quotationLine   QuotationLine @relation(fields: [quotationLineId], references: [id], onDelete: Cascade)
  warehouseId     Int?
  warehouse       Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity        Int

  @@index([quotationLineId])
  @@map("quotation_line_allocations")
}

// Promoted from the APPROVAL_LEVEL constant in discountEvaluation.service.js
// now that something persists it. NONE never gets a row here at all — a
// fully compliant quotation auto-confirms with no ApprovalRequest artifact
// (see QuotationStatus above).
enum ApprovalLevel {
  MANAGER
  MANAGER_FINANCE
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

// Every approval round is a NEW request, never a mutated one — old requests
// are never edited after they close. Makes post-negotiation re-approval a
// fresh, independently-auditable round rather than a reset of the first one.
model ApprovalRequest {
  id            Int                   @id @default(autoincrement())
  quotationId   Int
  quotation     Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  termsVersion  Int // snapshot: which version of the quotation this request is judging
  approvalLevel ApprovalLevel // from discountEvaluation.service.js's evaluateDiscount()
  status        ApprovalRequestStatus @default(PENDING)
  createdAt     DateTime              @default(now())

  steps ApprovalStep[]

  @@index([quotationId])
  @@index([status])
  @@map("approval_requests")
}

enum ApprovalStepRole {
  SALES_MANAGER
  FINANCE
}

enum ApprovalStepStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  RETURNED
}

model ApprovalStep {
  id                Int                @id @default(autoincrement())
  approvalRequestId Int
  approvalRequest   ApprovalRequest    @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  role              ApprovalStepRole
  sequence          Int // 1 = Sales Manager, 2 = Finance
  status            ApprovalStepStatus @default(PENDING)

  // Nullable: the step (and its note/timestamp) must survive even if the
  // acting user's account is later removed — only the attribution clears.
  actedById Int?
  actedBy   User?     @relation(fields: [actedById], references: [id], onDelete: SetNull)
  note      String?
  actedAt   DateTime?

  @@unique([approvalRequestId, sequence])
  @@index([role, status])
  @@map("approval_steps")
}

// "All approvals, rejections, and edits must be logged with user, timestamp,
// and reason" — satisfied by construction here, not by inference from other
// tables. userId is nullable for the same reason as ApprovalStep.actedById:
// the log entry is the record of truth and must outlive the user account.
model AuditLog {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String // "APPROVED", "REJECTED", "RETURNED", "WITHDRAWN", "LINE_EDITED", ...
  note        String?
  createdAt   DateTime  @default(now())

  @@index([quotationId, createdAt])
  @@map("audit_logs")
}
